// Zellij 設定ファイル

// テーマ
theme "kanagawa"

// デフォルトレイアウト
default_layout "compact"

// デフォルトモード
default_mode "normal"

// ペイン枠線
pane_frames false

// マウスモード
mouse_mode true

// スクロールバッファサイズ
scroll_buffer_size 50000

// コピーコマンド (macOS)
copy_command "pbcopy"

// OSC52によるコピー（ターミナルエミュレータ経由）
copy_on_select true

// UI 設定
ui {
    pane_frames {
        hide_session_name true
    }
}

// テーマ定義 (Kanagawa)
themes {
    kanagawa {
        fg "#DCD7BA"
        bg "#1F1F28"
        black "#090618"
        red "#C34043"
        green "#76946A"
        yellow "#C0A36E"
        blue "#7E9CD8"
        magenta "#957FB8"
        cyan "#6A9589"
        white "#C8C093"
        orange "#FFA066"
    }
}
